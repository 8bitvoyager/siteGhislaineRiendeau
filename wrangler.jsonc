{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghislaine-home-v2",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
