{
  "name": "ghislaine-home-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "surveiller": "node --watch-path=contenu --watch-path=modeles --watch-path=css --watch-path=js --watch-path=assets --watch-path=admin --watch-path=galerie scripts/build.mjs",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "check:deploy": "npm run build && wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "nunjucks": "^3.2.4",
    "sharp": "0.35.4",
    "wrangler": "4.135.0"
  }
}
