<!doctype html>
<html lang="fr-CA">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="data:,">
  <meta name="theme-color" content="#f8f6f2">
  <title>{{ titre }}</title>
{% for police in polices %}
  <link rel="preload" href="/assets/fonts/{{ police }}-latin.woff2" as="font" type="font/woff2" crossorigin>
{% endfor %}
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/styles.css">
{% for feuille in styles %}
  <link rel="stylesheet" href="{{ feuille }}">
{% endfor %}
  <script src="/js/main.js" defer></script>
{% for script in scripts %}
  <script src="{{ script }}" defer></script>
{% endfor %}
</head>
<body{% if classe %} class="{{ classe }}"{% endif %}>
  <a class="skip-link" href="#contenu">Aller au contenu</a>
{% include "partiels/entete.njk" %}
  <main id="contenu">
{% block contenu %}{% endblock %}
  </main>
{% include "partiels/pied.njk" %}
{% block apres %}{% endblock %}
</body>
</html>
